# Local runtime state. Keep only the placeholder so the directory exists in clones.
runs/*
!runs/.gitkeep
.slots/
.agent-work/
.worktrees/

# Machine-local configuration. Commit config/workspaces.example.toml instead.
# Every config here names absolute paths on one operator's machine, and there is one
# per controlled project, not just workspaces.toml.
config/*.toml
!config/workspaces.example.toml
*.sqlite3
*.sqlite3-*

# Generated reports and exports.
/output/
