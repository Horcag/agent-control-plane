__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
build/
dist/
*.egg-info/
*.iml
.idea/

# Local runtime state. Keep only the placeholder so the directory exists in clones.
runs/*
!runs/.gitkeep
.slots/
.agent-work/
.worktrees/

# Machine-local configuration. Commit config/workspaces.example.toml instead.
# Every config here names absolute paths on one operator's machine, and there is one
# per controlled project, not just workspaces.toml.
config/*.toml
!config/workspaces.example.toml
*.sqlite3
*.sqlite3-*

# Generated reports and exports.
/output/

# The board is machine-local and deliberately never committed. Two reasons, and the
# second one is not obvious: task text stays off the remote, and -- because this
# directory sits inside the route root of the `acp` route -- ignored paths never
# appear in `git status --porcelain`, which is what the route-root guard reads. A
# versioned board made every board write during a job look like a slot worker
# editing the route root, and killed the job.
/kanban/
